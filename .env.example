# Environment
NODE_ENV=development

# Supabase (Identity Provider + PostgreSQL host)
# Local defaults after `npx supabase start`:
#   API:  http://127.0.0.1:54321
#   DB:   postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma / PostgreSQL
# DIRECT_URL: privileged connection for migrations + restricted tenant bootstrap only
# DATABASE_URL: same host for VS1; user requests still SET LOCAL ROLE authenticated
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
