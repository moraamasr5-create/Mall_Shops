# Environment
NODE_ENV=development

# Supabase (Identity Provider + PostgreSQL host)
# Local defaults after `npx supabase start`:
#   API:  http://127.0.0.1:54321
#   DB:   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: Project Settings → API + Database (pooler recommended on Windows)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma / PostgreSQL (OP-002 role split)
# DATABASE_URL: app_runtime (LOGIN, NOBYPASSRLS) — user-facing Prisma + withIdentityRls
# DIRECT_URL:   postgres (or migration role) — prisma migrate + createTenant only
#
# Hosted pooler usernames need project ref suffix, e.g.:
#   app_runtime.<PROJECT_REF>  /  postgres.<PROJECT_REF>
# Prefer session-mode pooler (port 5432) for SET LOCAL ROLE transactions.
#
# Local (pre-hardening / docker): both may point at postgres for bootstrap.
# Staging/production after OP-002: DATABASE_URL must use app_runtime.
DATABASE_URL=postgresql://app_runtime:your-app-runtime-password@127.0.0.1:54322/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
