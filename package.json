{
  "name": "mall-shops",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant multi-module Business Operating Platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "verify": "npm run check:architecture && npm run prisma:generate && npm run typecheck && npm test",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "smoke:vs1": "node scripts/smoke-vs1.mjs",
    "smoke:restaurant-a1": "node scripts/smoke-restaurant-a1.mjs",
    "smoke:restaurant-a2": "node scripts/smoke-restaurant-a2.mjs",
    "smoke:restaurant-a3": "node scripts/smoke-restaurant-a3.mjs",
    "smoke:restaurant-a4": "node scripts/smoke-restaurant-a4.mjs",
    "smoke:restaurant-a5": "node scripts/smoke-restaurant-a5.mjs",
    "smoke:restaurant-a6": "node scripts/smoke-restaurant-a6.mjs",
    "smoke:restaurant-a7": "node scripts/smoke-restaurant-a7.mjs",
    "smoke:restaurant-a8": "node scripts/smoke-restaurant-a8.mjs",
    "evidence:cross-tenant": "node scripts/evidence-cross-tenant.mjs",
    "check:env": "node scripts/check-environment.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@supabase/supabase-js": "^2.50.2",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "prisma": "^6.10.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
