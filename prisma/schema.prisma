generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Organizational isolation boundary. No owner_id — ownership via Membership(role=OWNER).
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  tenantModules TenantModule[]

  @@map("tenant")
}

/// Links Identity Provider UID to a Tenant with an explicit Role.
model Membership {
  id         String   @id @default(cuid())
  identityId String   @map("identity_id")
  tenantId   String   @map("tenant_id")
  role       String
  status     String   @default("active")
  invitedBy  String?  @map("invited_by")
  joinedAt   DateTime @default(now()) @map("joined_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([identityId, tenantId])
  @@index([identityId])
  @@index([tenantId])
  @@map("membership")
}

/// VS1 Implementation choice: TenantModule activation persisted as a table.
/// Architecture treats TenantModule as a relationship only — storage is not locked.
model TenantModule {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  moduleKey   String   @map("module_key")
  enabled     Boolean  @default(true)
  activatedAt DateTime @default(now()) @map("activated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("tenant_module")
}

/// Salon Reference Module — minimum entity for Vertical Slice 1.
model SalonService {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  durationMin Int      @map("duration_min")
  priceCents  Int      @map("price_cents")
  currency    String   @default("SAR")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("salon_service")
}

/// Salon Reference Module — employee entity owned by the Salon module.
model SalonEmployee {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  title     String?
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("salon_employee")
}

/// Salon Reference Module — customer entity owned by the Salon module.
model SalonCustomer {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("salon_customer")
}

/// Salon operational unit of work (OP-005). Not reservation, invoice, payment, or queue.
model SalonVisit {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  status     String    @default("open")
  customerId String    @map("customer_id")
  employeeId String?   @map("employee_id")
  notes      String?
  openedAt   DateTime  @default(now()) @map("opened_at")
  closedAt   DateTime? @map("closed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  services SalonVisitService[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@map("salon_visit")
}

/// Line under SalonVisit — snapshot of catalog service at add time (no JSON).
model SalonVisitService {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  visitId     String   @map("visit_id")
  serviceId   String   @map("service_id")
  name        String
  priceCents  Int      @map("price_cents")
  currency    String
  durationMin Int      @map("duration_min")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  visit SalonVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([visitId])
  @@map("salon_visit_service")
}

/// Restaurant Reference Module — category entity owned by the Restaurant module.
model RestaurantCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  menuItems RestaurantMenuItem[]

  @@index([tenantId])
  @@map("restaurant_category")
}

/// Restaurant MenuItem Aggregate Root (MENU Contract) — Module-owned; not Core.
model RestaurantMenuItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  categoryId  String   @map("category_id")
  name        String
  description String?
  priceCents  Int      @map("price_cents")
  currency    String   @default("SAR")
  /// Available for new Orders (MENU availability).
  available   Boolean  @default(true)
  /// Retired = permanently not sellable for new Orders.
  retired     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category RestaurantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("restaurant_menu_item")
}

/// RestaurantEmployee = assignment on Core Membership (not a Staff Aggregate).
model RestaurantEmployeeAssignment {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  membershipId   String    @map("membership_id")
  /// Module role: cashier | kitchen | manager | pilot (Contract vocabulary).
  restaurantRole String    @map("restaurant_role")
  status         String    @default("active")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, membershipId, restaurantRole])
  @@index([tenantId])
  @@index([membershipId])
  @@map("restaurant_employee_assignment")
}

/// Restaurant Order — Primary Work Unit (ORDER Contract). Module-owned.
model RestaurantOrder {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  status                String    @default("created")
  /// Fulfillment.mode on Order (Entity) — dine_in | pickup | delivery
  fulfillmentMode       String    @map("fulfillment_mode")
  guestName             String?   @map("guest_name")
  /// PaymentAcceptance snapshot (v1 VO on Order — not Payment Aggregate)
  paymentAccepted       Boolean   @default(false) @map("payment_accepted")
  paymentMethod         String?   @map("payment_method")
  paymentAcceptedAt     DateTime? @map("payment_accepted_at")
  openedAt              DateTime  @default(now()) @map("opened_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  lines RestaurantOrderLine[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@map("restaurant_order")
}

/// OrderLine — price/name snapshot at create/confirm (MENU does not rewrite history).
model RestaurantOrderLine {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  orderId     String   @map("order_id")
  menuItemId  String   @map("menu_item_id")
  name        String
  quantity    Int      @default(1)
  priceCents  Int      @map("price_cents")
  currency    String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("restaurant_order_line")
}
